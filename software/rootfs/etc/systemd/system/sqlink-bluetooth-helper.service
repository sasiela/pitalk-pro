[Unit]
Description=SQLink Bluetooth pairing and audio management
Requires=bluetooth.service
After=bluetooth.service user@1002.service
Wants=user@1002.service

[Service]
ExecStart=/usr/bin/python3 /usr/local/sbin/sqlink-bluetooth-helper.py
RuntimeDirectory=sqlink-bluetooth
RuntimeDirectoryMode=0755
StateDirectory=sqlink-bluetooth
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
